# ==============================================================================
# Lyftr AI Chatbot — Environment Configuration Template
# ==============================================================================

# Primary Google Gemini API key (Required for chat and live inference)
GEMINI_API_KEY_1=your_gemini_api_key_1_here

# Secondary Google Gemini API key (Optional / Recommended for automatic failover)
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Gemini Model Identifier (Default: gemini/gemini-2.0-flash)
GEMINI_MODEL=gemini/gemini-2.0-flash

# Database Connection URL:
# - Local development default: sqlite:///./data/app.db
# - Docker / Render persistent container mount: sqlite:////data/app.db
DATABASE_URL=sqlite:///./data/app.db

# Failure Simulation Flag:
# Set to 'true' to allow evaluator testing via X-Simulate-Failure request header.
# Keep 'false' for production deployments.
ENABLE_FAILURE_SIMULATION=false

# CORS Allowed Origins:
# Accepts: '*' (wildcard), comma-separated URLs, or JSON array string.
# Example: http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=*

# Frontend API Base URL (Build-time baked arg for Vite bundle)
VITE_API_URL=http://localhost:8000

# Backend logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
