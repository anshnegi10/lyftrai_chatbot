# Gemini API Keys (required)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Database (uses Docker volume by default)
DATABASE_URL=sqlite:////data/app.db

# Failure Simulation (enable for testing failover)
ENABLE_FAILURE_SIMULATION=true

# CORS Origins (comma-separated list or * for all)
CORS_ORIGINS=*

# Frontend API URL
VITE_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
